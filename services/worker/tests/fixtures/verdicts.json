    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 12345678901234567890},
    "result": {"ok": false, "error": "JSON value at $.v is not 12345678901234567000"}
  },
  {
    "name": "json value: a 20-digit integer equals its rounded form",
    "replies": [{"body": "{\"v\":12345678901234567000}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 12345678901234567890},
    "result": {"ok": true}
  },
