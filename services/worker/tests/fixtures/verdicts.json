    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 0},
    "result": {"ok": true}
  },
  {
    "name": "json value: a fraction prints as written",
    "replies": [{"body": "{\"v\":2}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 1.5},
    "result": {"ok": false, "error": "JSON value at $.v is not 1.5"}
  },
  {
    "name": "json value: 1e21 prints with an exponent",
