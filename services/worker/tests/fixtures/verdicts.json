[
  {
    "name": "json value: 3.0 in the body equals 3",
    "replies": [{"body": "{\"v\":3.0}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 3},
    "result": {"ok": true}
  },
  {
    "name": "json value: 1e2 in the body equals 100",
    "replies": [{"body": "{\"v\":1e2}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 100},
    "result": {"ok": true}
  },
  {
    "name": "json value: -0 in the body equals 0",
