    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": "ab"},
    "result": {"ok": false, "error": "JSON value at $.v is not \"ab\""}
  },
  {
    "name": "json value: a string with control characters escapes them",
    "replies": [{"body": "{\"v\":\"x\"}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": "a\tb\nc\u0001d\u001f"},
    "result": {"ok": false, "error": "JSON value at $.v is not \"a\\tb\\nc\\u0001d\\u001f\""}
  },
  {
    "name": "json value: an escaped body string equals the plain string",
    "replies": [{"body": "{\"v\":\"caf\\u00e9\"}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": "café"},
    "result": {"ok": true}
  },
  {
    "name": "json value: the last of two duplicate keys counts",
    "replies": [{"body": "{\"status\":\"down\",\"status\":\"ok\"}"}],
    "monitor": {"responseJsonPath": "$.status", "responseJsonValue": "ok"},
    "result": {"ok": true}
  },
  {
    "name": "json value: an unpaired surrogate escape elsewhere still parses",
    "replies": [{"body": "{\"note\":\"\\ud83d\",\"status\":\"ok\"}"}],
    "monitor": {"responseJsonPath": "$.status", "responseJsonValue": "ok"},
    "result": {"ok": true}
  },
  {
    "name": "json value: a number beyond a float64 fails the check",
    "replies": [{"body": "{\"v\":1e400}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 1.7976931348623157e308},
    "deviation": "JSON.parse reads 1e400 as Infinity, so the TypeScript proxy reports the value at $.v. The proxy reports that the response is not valid JSON.",
    "result": {"ok": false}
  },
