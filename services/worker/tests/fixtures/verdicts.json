    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 1e+21},
    "result": {"ok": false, "error": "JSON value at $.v is not 1e+21"}
  },
  {
    "name": "json value: 1e20 prints in full",
    "replies": [{"body": "{\"v\":1}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 1e+20},
    "result": {"ok": false, "error": "JSON value at $.v is not 100000000000000000000"}
  },
  {
    "name": "json value: 1e-7 prints with an exponent",
    "replies": [{"body": "{\"v\":1}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 1e-07},
    "result": {"ok": false, "error": "JSON value at $.v is not 1e-7"}
  },
  {
    "name": "json value: 0.000001 prints in full",
    "replies": [{"body": "{\"v\":1}"}],
    "monitor": {"responseJsonPath": "$.v", "responseJsonValue": 1e-06},
    "result": {"ok": false, "error": "JSON value at $.v is not 0.000001"}
  },
  {
    "name": "json value: a 20-digit integer prints rounded",
