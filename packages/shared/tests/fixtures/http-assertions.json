  {
    "name": "responseKeyword: present passes",
    "monitor": { "responseKeyword": "success" },
    "reply": { "status": 200, "headers": {}, "body": "Operation success completed" },
    "error": null
  },
  {
    "name": "responseKeyword: absent fails",
    "monitor": { "responseKeyword": "success" },
    "reply": { "status": 200, "headers": {}, "body": "Operation failed" },
    "error": "Required keyword \"success\" not found in response"
  },
  {
    "name": "responseKeyword: matches case",
    "monitor": { "responseKeyword": "SUCCESS" },
    "reply": { "status": 200, "headers": {}, "body": "success" },
    "error": "Required keyword \"SUCCESS\" not found in response"
  },
  {
    "name": "responseKeyword: an empty body fails",
    "monitor": { "responseKeyword": "ok" },
    "reply": { "status": 200, "headers": {}, "body": "" },
    "error": "Required keyword \"ok\" not found in response"
  },
  {
    "name": "responseForbiddenKeyword: present fails",
    "monitor": { "responseForbiddenKeyword": "error" },
    "reply": { "status": 200, "headers": {}, "body": "An error occurred" },
    "error": "Forbidden keyword \"error\" found in response"
  },
  {
    "name": "responseForbiddenKeyword: absent passes",
    "monitor": { "responseForbiddenKeyword": "error" },
    "reply": { "status": 200, "headers": {}, "body": "All good" },
    "error": null
  },
  {
    "name": "both keywords: required present and forbidden absent passes",
    "monitor": { "responseKeyword": "ok", "responseForbiddenKeyword": "error" },
    "reply": { "status": 200, "headers": {}, "body": "status: ok" },
    "error": null
  },
  {
    "name": "both keywords: required absent fails",
    "monitor": { "responseKeyword": "ok", "responseForbiddenKeyword": "error" },
    "reply": { "status": 200, "headers": {}, "body": "status: done" },
    "error": "Required keyword \"ok\" not found in response"
  },
  {
    "name": "both keywords: forbidden present fails",
    "monitor": { "responseKeyword": "ok", "responseForbiddenKeyword": "error" },
    "reply": { "status": 200, "headers": {}, "body": "ok but error" },
    "error": "Forbidden keyword \"error\" found in response"
  },
  {
    "name": "responseHeaderEquals: an equal value passes",
    "monitor": { "responseHeaderEquals": { "X-Version": "2" } },
