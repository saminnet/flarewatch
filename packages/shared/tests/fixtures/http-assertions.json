    "error": "Response is not valid JSON"
  },
  {
    "name": "responseJsonPath: an empty body fails",
    "monitor": { "responseJsonPath": "$.status", "responseJsonValue": "ok" },
    "reply": { "status": 200, "headers": {}, "body": "" },
    "error": "Response is not valid JSON"
  },
  {
    "name": "order: status before headers",
    "monitor": { "responseHeaderEquals": { "X-Mode": "live" } },
    "reply": { "status": 503, "headers": { "X-Mode": "maintenance" }, "body": "" },
    "error": "Expected 2xx status, got 503"
  },
  {
    "name": "order: status before body",
    "monitor": { "responseKeyword": "ok" },
    "reply": { "status": 500, "headers": {}, "body": "down" },
    "error": "Expected 2xx status, got 500"
  },
  {
    "name": "order: status before a body that is not JSON",
    "monitor": { "responseJsonPath": "$.a", "responseJsonValue": 1 },
    "reply": { "status": 503, "headers": {}, "body": "<html></html>" },
    "error": "Expected 2xx status, got 503"
  },
  {
    "name": "order: headers before a keyword",
    "monitor": { "responseHeaderEquals": { "X-Mode": "maintenance" }, "responseKeyword": "ok" },
    "reply": { "status": 200, "headers": { "X-Mode": "live" }, "body": "down" },
    "error": "Header \"X-Mode\" does not have the expected value"
  },
  {
    "name": "order: headers before a forbidden keyword",
    "monitor": {
      "responseHeaderEquals": { "X-Version": "2" },
      "responseForbiddenKeyword": "error"
    },
    "reply": { "status": 200, "headers": {}, "body": "error" },
    "error": "Header \"X-Version\" not found in response"
  },
  {
    "name": "order: headers before a JSON path",
    "monitor": {
      "responseHeaderEquals": { "Content-Type": "application/json" },
      "responseJsonPath": "$.status",
      "responseJsonValue": "ok"
    },
    "reply": { "status": 200, "headers": { "Content-Type": "text/html" }, "body": "<html></html>" },
    "error": "Header \"Content-Type\" does not have the expected value"
  },
  {
    "name": "all assertions pass together",
    "monitor": {
      "expectedCodes": [200],
      "responseKeyword": "pass",
      "responseForbiddenKeyword": "fail",
      "responseHeaderEquals": { "Content-Type": "application/json" },
      "responseJsonPath": "$.checks[0].status",
      "responseJsonValue": "pass"
    },
    "reply": {
      "status": 200,
      "headers": { "Content-Type": "application/json" },
      "body": "{\"checks\":[{\"status\":\"pass\"}]}"
    },
    "error": null
  }
