    "error": "JSON value at $.status is not \"ok\""
  },
  {
    "name": "responseJsonPath: a nested path passes",
    "monitor": { "responseJsonPath": "$.a.b[0].c", "responseJsonValue": "ok" },
    "reply": { "status": 200, "headers": {}, "body": "{\"a\":{\"b\":[{\"c\":\"ok\"}]}}" },
    "error": null
  },
  {
    "name": "responseJsonPath: an index at the root passes",
    "monitor": { "responseJsonPath": "$[1]", "responseJsonValue": "y" },
    "reply": { "status": 200, "headers": {}, "body": "[\"x\",\"y\"]" },
    "error": null
  },
