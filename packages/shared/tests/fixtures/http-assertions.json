    "error": null
  },
  {
    "name": "responseHeaderEquals: a different value fails",
    "monitor": { "responseHeaderEquals": { "X-Version": "2" } },
    "reply": { "status": 200, "headers": { "X-Version": "3" }, "body": "" },
    "error": "Header \"X-Version\" does not have the expected value"
  },
  {
    "name": "responseHeaderEquals: a value in another case fails",
    "monitor": { "responseHeaderEquals": { "cache-control": "no-store" } },
    "reply": { "status": 200, "headers": { "Cache-Control": "No-Store" }, "body": "" },
    "error": "Header \"cache-control\" does not have the expected value"
  },
  {
    "name": "responseHeaderEquals: a missing header fails",
    "monitor": { "responseHeaderEquals": { "X-Version": "2" } },
    "reply": { "status": 200, "headers": {}, "body": "" },
    "error": "Header \"X-Version\" not found in response"
  },
  {
    "name": "responseHeaderEquals: a lower-case name matches a mixed-case header",
    "monitor": { "responseHeaderEquals": { "cache-control": "no-store" } },
    "reply": { "status": 200, "headers": { "Cache-Control": "no-store" }, "body": "" },
    "error": null
  },
  {
    "name": "responseHeaderEquals: a mixed-case name matches a lower-case header",
    "monitor": { "responseHeaderEquals": { "Content-Type": "application/json" } },
    "reply": { "status": 200, "headers": { "content-type": "application/json" }, "body": "{}" },
    "error": null
  },
  {
    "name": "responseHeaderEquals: every listed header must match",
    "monitor": { "responseHeaderEquals": { "X-One": "1", "X-Two": "2" } },
    "reply": { "status": 200, "headers": { "X-One": "1" }, "body": "" },
    "error": "Header \"X-Two\" not found in response"
  },
  {
    "name": "responseJsonPath: an equal string passes",
    "monitor": { "responseJsonPath": "$.status", "responseJsonValue": "ok" },
    "reply": { "status": 200, "headers": {}, "body": "{\"status\":\"ok\"}" },
    "error": null
  },
  {
    "name": "responseJsonPath: a different string fails",
    "monitor": { "responseJsonPath": "$.status", "responseJsonValue": "ok" },
