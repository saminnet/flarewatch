# Optional: protect the status page with Basic Auth.
# Format: JSON payload from:
# pnpm auth:secret -- <username> '<password>'
# Do not manually edit JSON fields.
FLAREWATCH_STATUS_PAGE_BASIC_AUTH=

# Required for admin access (/admin and /api/admin routes)
# Format: JSON payload from:
# pnpm auth:secret -- <username> '<password>'
# Do not manually edit JSON fields.
FLAREWATCH_ADMIN_BASIC_AUTH=
