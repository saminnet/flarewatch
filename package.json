{
  "name": "flarewatch",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "compile": "vp check --no-fmt --no-lint",
    "check": "vp check",
    "auth:secret": "node --experimental-strip-types scripts/generate-auth-secret.ts",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "lint": "vp lint"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
